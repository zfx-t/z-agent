{
	"name": "@z-agent/cli",
	"version": "0.0.0",
	"private": true,
	"description": "Minimal smoke CLI for @z-agent/agent + @z-agent/ai",
	"type": "module",
	"bin": {
		"z-agent": "./bin/z-agent.mjs"
	},
	"exports": {
		".": {
			"types": "./src/cli.ts",
			"import": "./src/cli.ts"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"bin",
		"src",
		"README.md"
	],
	"scripts": {
		"start": "node ./bin/z-agent.mjs",
		"test": "vitest --run"
	},
	"engines": {
		"node": ">=22.0.0"
	},
	"license": "MIT",
	"dependencies": {
		"@z-agent/agent": "0.0.0",
		"@z-agent/ai": "0.0.0",
		"zod": "3.25.76"
	}
}
